{
  "name": "navidanindya",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/navidanindya/navidanindya",
  "author": {
    "name": "Navid Anindya",
    "email": "navidanindya@gmail.com",
    "url": "https://navidanindya.info"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider nuxt",
    "build": "NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "start": "NODE_OPTIONS=--openssl-legacy-provider nuxt start",
    "generate": "NODE_OPTIONS=--openssl-legacy-provider nuxt generate --fail-on-error",
    "seed:views": "case \"$VIEWS_TABLE\" in entry_views|entry_views_preview) wrangler d1 execute \"${VIEWS_DATABASE_NAME:?Set VIEWS_DATABASE_NAME}\" --remote --yes --file \".nuxt/$VIEWS_TABLE.sql\" ;; *) echo Set VIEWS_TABLE to entry_views or entry_views_preview >&2; exit 1 ;; esac",
    "preview:pages": "wrangler pages dev dist --d1 VIEWS_DB=00000000-0000-4000-8000-000000000001 --binding VIEWS_TABLE=entry_views --ip 0.0.0.0 --port 8788",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint": "npm run lint:js"
  },
  "dependencies": {
    "@nuxt/content": "^1.15.1",
    "@nuxtjs/axios": "^5.12.5",
    "@nuxtjs/feed": "^2.0.0",
    "@nuxtjs/markdownit": "^2.0.0",
    "@nuxtjs/pwa": "^3.3.5",
    "@nuxtjs/sitemap": "^2.4.0",
    "core-js": "^3.51.0",
    "nuxt": "2.18.1",
    "prism-themes": "^1.6.0"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config": "^6.0.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "^0.5.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.18.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "postcss": "^8.5.32",
    "wrangler": "4.159.0"
  },
  "overrides": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.0",
    "webpack": "4.47.0"
  }
}
